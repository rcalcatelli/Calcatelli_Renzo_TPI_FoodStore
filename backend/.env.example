# Conexión a PostgreSQL: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
# La base "foodstore_db" se crea sola si no existe.
# Para desarrollo sin PostgreSQL: DATABASE_URL=sqlite:///./foodstore.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodstore_db

# Firma del JWT: mínimo 32 caracteres (cambiarla en cada instalación)
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256

# Expiración del token y de la cookie, en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido en CORS
FRONTEND_ORIGIN=http://localhost:5173
